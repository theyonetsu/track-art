# ─── Track.Art backend ───────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:3000            # URL publique du frontend (liens dans les emails)
API_URL=http://localhost:3001

# Base de données PostgreSQL (docker compose en local)
DATABASE_URL=postgresql://admin:admin@localhost:5432/trackart

# Secrets (générer des valeurs longues et aléatoires en production : openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
TOTP_ENCRYPT_KEY=change-me

# Stockage LOCAL : MinIO (docker compose). Laisser vide en production.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=trackart-photos
MINIO_USE_SSL=false

# Stockage PRODUCTION : Cloudflare R2 (si R2_ENDPOINT est défini, MinIO est ignoré)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=trackart-photos

# PayPal — https://developer.paypal.com → Apps & Credentials → Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                        # sandbox | live
PAYPAL_WEBHOOK_ID=

# Emails (SMTP). Brevo, Resend, Mailgun, OVH… Vide = emails désactivés.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Track.Art <no-reply@trak.art>"

# Compte super-admin créé par `npm run seed`
ADMIN_EMAIL=admin@track.art
ADMIN_PASSWORD=ChangeMe123!
